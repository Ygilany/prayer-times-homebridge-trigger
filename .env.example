# Location. Coordinates are the primary lookup because Aladhan's geocoding
# service (used by the city lookup) returns 503 for days at a time.
LATITUDE='39.3601'
LONGITUDE='-84.3099'

# City lookup, used only as a fallback if the coordinate lookup fails.
API_CITY='Mason'
API_COUNTRY='US'
API_STATE='OH'

API_METHOD='2'  # 2 = ISNA
API_TIMEZONE='America/New_York'

# Homebridge
HOME_BRIDGE_HOST='127.0.0.1'
WEBHOOK_PORT=63743  # must match webhook_port in Dummy plugin config
ACCESSORY_ID='dailyScene'  # must match the "id" for your switch

# Retry policy for the daily fetch (optional; these are the defaults)
# FETCH_ATTEMPTS=6
# FETCH_BACKOFF_MS=30000

# Where to remember the last known good times (optional)
# CACHE_FILE='./.last-known-times.json'

# Override the API base URL (optional; used for testing failure paths)
# ALADHAN_BASE_URL='https://api.aladhan.com/v1'
